# ---------------------------------------------------------------------------
# GatePass server configuration
# Copy to `server/.env` and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# REQUIRED — Neon Postgres connection string.
# Get it from https://console.neon.tech -> your project -> Connection string.
# Use the *pooled* connection string and keep `sslmode=require`.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# REQUIRED — HS256 signing key for login sessions. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional — separate signing key for gatepass QR tokens. Falls back to JWT_SECRET.
QR_SECRET=

# Optional — Brevo transactional email. Without it the server runs in
# dry-run mode: emails are logged to the console instead of being sent.
# Key from https://app.brevo.com -> SMTP & API -> API Keys (v3).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@gatepass.local
BREVO_SENDER_NAME=GatePass

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# Public URL of the React client — used to build links inside emails.
APP_URL=http://localhost:5173

# Organisation timezone offset in minutes from UTC (330 = IST, 0 = UTC, -300 = EST).
# The 30-minute reminder cron uses this to decide what "now" means locally.
TZ_OFFSET_MINUTES=330

# Background jobs. Set to "false" to disable the reminder cron.
ENABLE_CRON=true

# Quote any value containing # or spaces — an unquoted # starts an inline comment
# and the rest of the value is silently discarded.  e.g.  PASSWORD="Abcd1234#"

# Bootstrap admin, created on first boot if no ADMIN user exists.
SEED_ADMIN_EMAIL=admin@gatepass.local
SEED_ADMIN_PASSWORD=Admin@123

# Set to "true" to insert demo rooms, an authority and a guard on boot.
SEED_DEMO_DATA=true
